generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CUSTOMER
  EMPLOYEE
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Account {
  id String @id @default(uuid()) @db.Uuid

  accountType AccountType
  status      AccountStatus @default(PENDING)

  email String? @unique @db.VarChar(255)
  phone String  @unique @db.VarChar(20)

  passwordHash String @db.VarChar(255)

  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  preferredLanguage   String    @default("ar") @db.VarChar(10)
  timezone            String    @default("Asia/Riyadh") @db.VarChar(50)
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  customerProfile CustomerProfile?
  employeeProfile EmployeeProfile?

  sessions  Session[]
  auditLogs AuditLog[]

  @@index([status], map: "idx_account_status")
  @@index([accountType], map: "idx_account_type")
}

model CustomerClassification {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(50)
  description String? @db.Text

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers CustomerProfile[]
}

model CustomerProfile {
  id String @id @default(uuid()) @db.Uuid

  accountId String @unique @db.Uuid

  customerCode String @unique @db.VarChar(50)

  classificationId String @db.Uuid

  firstName String  @db.VarChar(100)
  lastName  String? @db.VarChar(100)

  gender    Gender?
  birthDate DateTime?

  marketingConsent Boolean @default(false)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  classification CustomerClassification @relation(fields: [classificationId], references: [id], onDelete: Restrict)

  @@index([classificationId], map: "idx_customer_profile_classification")
}

model Department {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(50)
  description String? @db.Text

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees EmployeeProfile[]
}

model EmployeeProfile {
  id String @id @default(uuid()) @db.Uuid

  accountId String @unique @db.Uuid

  employeeNumber String @unique @db.VarChar(50)

  departmentId String @db.Uuid

  firstName String  @db.VarChar(100)
  lastName  String? @db.VarChar(100)

  nationalId String? @unique @db.VarChar(50)

  hireDate DateTime?

  jobTitle String? @db.VarChar(100)

  salary Decimal? @db.Decimal(12, 2)

  managerId String? @db.Uuid

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  manager EmployeeProfile? @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)

  subordinates EmployeeProfile[] @relation("EmployeeManager")

  employeeRoles EmployeeRole[]

  @@index([departmentId], map: "idx_employee_department")
  @@index([managerId], map: "idx_employee_manager")
}

model Role {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(50)
  description String? @db.Text

  isSystem Boolean @default(false)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeRoles   EmployeeRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(50)
  description String? @db.Text

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([module], map: "idx_permission_module")
}

model EmployeeRole {
  id String @id @default(uuid()) @db.Uuid

  employeeId String @db.Uuid
  roleId     String @db.Uuid

  createdAt DateTime @default(now())

  employee EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([employeeId, roleId], map: "uq_employee_role")
  @@index([roleId], map: "idx_employee_role_role")
}

model RolePermission {
  id String @id @default(uuid()) @db.Uuid

  roleId       String @db.Uuid
  permissionId String @db.Uuid

  createdAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId], map: "uq_role_permission")
  @@index([permissionId], map: "idx_role_permission_permission")
}

model Session {
  id String @id @default(uuid()) @db.Uuid

  accountId String @db.Uuid

  refreshToken String @unique @db.VarChar(500)

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.Text
  device    String? @db.VarChar(100)

  expiresAt      DateTime
  lastActivityAt DateTime?

  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId], map: "idx_session_account")
  @@index([expiresAt], map: "idx_session_expires")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  accountId String? @db.Uuid

  action   String  @db.VarChar(100)
  entity   String  @db.VarChar(100)
  entityId String? @db.VarChar(100)

  oldValue String? @db.Text
  newValue String? @db.Text

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.Text

  createdAt DateTime @default(now())

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId], map: "idx_audit_account")
  @@index([entity, entityId], map: "idx_audit_entity")
  @@index([createdAt], map: "idx_audit_created")
}
