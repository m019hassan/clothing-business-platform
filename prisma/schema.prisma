generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CUSTOMER
  EMPLOYEE
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Account {
  id String @id @default(uuid()) @db.Uuid

  accountType AccountType
  status      AccountStatus @default(PENDING)

  email String? @unique @db.VarChar(255)
  phone String  @unique @db.VarChar(20)

  passwordHash String @db.VarChar(255)

  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  preferredLanguage   String    @default("ar") @db.VarChar(10)
  timezone            String    @default("Asia/Riyadh") @db.VarChar(50)
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  customerProfile CustomerProfile?
  employeeProfile EmployeeProfile?

  stockMovements StockMovement[] @relation("StockMovementActor")

  sessions  Session[]
  auditLogs AuditLog[]

  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  @@index([status], map: "idx_account_status")
  @@index([accountType], map: "idx_account_type")
}

model CustomerClassification {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(50)
  description String? @db.Text

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers CustomerProfile[]
}

model CustomerProfile {
  id String @id @default(uuid()) @db.Uuid

  accountId String @unique @db.Uuid

  customerCode String @unique @db.VarChar(50)

  classificationId String @db.Uuid

  firstName String  @db.VarChar(100)
  lastName  String? @db.VarChar(100)

  gender    Gender?
  birthDate DateTime?

  marketingConsent Boolean @default(false)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  classification CustomerClassification @relation(fields: [classificationId], references: [id], onDelete: Restrict)

  carts     Cart[]
  orders    Order[]
  addresses Address[]

  @@index([classificationId], map: "idx_customer_profile_classification")
}

model Department {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(50)
  description String? @db.Text

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees EmployeeProfile[]
}

model EmployeeProfile {
  id String @id @default(uuid()) @db.Uuid

  accountId String @unique @db.Uuid

  employeeNumber String @unique @db.VarChar(50)

  departmentId String @db.Uuid

  firstName String  @db.VarChar(100)
  lastName  String? @db.VarChar(100)

  nationalId String? @unique @db.VarChar(50)

  hireDate DateTime?

  jobTitle String? @db.VarChar(100)

  salary Decimal? @db.Decimal(12, 2)

  managerId String? @db.Uuid

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  manager EmployeeProfile? @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)

  subordinates EmployeeProfile[] @relation("EmployeeManager")

  employeeRoles EmployeeRole[]

  @@index([departmentId], map: "idx_employee_department")
  @@index([managerId], map: "idx_employee_manager")
}

model Role {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(50)
  description String? @db.Text

  isSystem Boolean @default(false)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeRoles   EmployeeRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(50)
  description String? @db.Text

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([module], map: "idx_permission_module")
}

model EmployeeRole {
  id String @id @default(uuid()) @db.Uuid

  employeeId String @db.Uuid
  roleId     String @db.Uuid

  createdAt DateTime @default(now())

  employee EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([employeeId, roleId], map: "uq_employee_role")
  @@index([roleId], map: "idx_employee_role_role")
}

model RolePermission {
  id String @id @default(uuid()) @db.Uuid

  roleId       String @db.Uuid
  permissionId String @db.Uuid

  createdAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId], map: "uq_role_permission")
  @@index([permissionId], map: "idx_role_permission_permission")
}

model Session {
  id String @id @default(uuid()) @db.Uuid

  accountId String @db.Uuid

  refreshToken String @unique @db.VarChar(500)

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.Text
  device    String? @db.VarChar(100)

  expiresAt      DateTime
  lastActivityAt DateTime?

  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId], map: "idx_session_account")
  @@index([expiresAt], map: "idx_session_expires")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  accountId String? @db.Uuid

  action   String  @db.VarChar(100)
  entity   String  @db.VarChar(100)
  entityId String? @db.VarChar(100)

  oldValue String? @db.Text
  newValue String? @db.Text

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.Text

  createdAt DateTime @default(now())

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId], map: "idx_audit_account")
  @@index([entity, entityId], map: "idx_audit_entity")
  @@index([createdAt], map: "idx_audit_created")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

model Category {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(100)
  slug        String  @unique @db.VarChar(100)
  description String? @db.Text

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive], map: "idx_category_active")
}

model Product {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(150)
  slug        String  @unique @db.VarChar(150)
  description String? @db.Text

  status    ProductStatus @default(DRAFT)
  basePrice Decimal       @db.Decimal(12, 2)
  currency  String        @default("SAR") @db.VarChar(10)

  categoryId String @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]

  @@index([status], map: "idx_product_status")
  @@index([categoryId], map: "idx_product_category")
}

model ProductVariant {
  id String @id @default(uuid()) @db.Uuid

  productId String @db.Uuid

  sku   String @unique @db.VarChar(50)
  size  String? @db.VarChar(50)
  color String? @db.VarChar(50)

  priceOverride Decimal? @db.Decimal(12, 2)

  status ProductStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryItems InventoryItem[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  movements      StockMovement[]

  @@index([productId], map: "idx_variant_product")
}

model Warehouse {
  id String @id @default(uuid()) @db.Uuid

  name String @db.VarChar(100)
  code String @unique @db.VarChar(50)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryItems InventoryItem[]
  movements      StockMovement[]

  @@index([isActive], map: "idx_warehouse_active")
}

model InventoryItem {
  id String @id @default(uuid()) @db.Uuid

  variantId   String @db.Uuid
  warehouseId String @db.Uuid

  quantityOnHand   Int @default(0)
  quantityReserved Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([variantId, warehouseId], map: "uq_inventory_item_variant_warehouse")
  @@index([warehouseId], map: "idx_inventory_item_warehouse")
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

model Delivery {
  id String @id @default(uuid()) @db.Uuid

  orderId String @unique @db.Uuid

  status DeliveryStatus @default(PENDING)

  carrier        String? @db.VarChar(100)
  trackingNumber String? @db.VarChar(100)
  notes          String? @db.Text

  dispatchedAt DateTime?
  deliveredAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status], map: "idx_delivery_status")
}

model Address {
  id String @id @default(uuid()) @db.Uuid

  customerProfileId String @db.Uuid

  label String? @db.VarChar(50)

  recipientName String @db.VarChar(100)
  phone         String @db.VarChar(30)

  line1      String  @db.VarChar(200)
  line2      String? @db.VarChar(200)
  city       String  @db.VarChar(100)
  region     String? @db.VarChar(100)
  postalCode String? @db.VarChar(20)
  country    String  @default("SA") @db.VarChar(2)

  isDefault Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  orders          Order[]

  @@index([customerProfileId], map: "idx_address_customer")
  @@index([customerProfileId, isDefault], map: "idx_address_customer_default")
}

enum StockMovementType {
  ADJUSTMENT
  INTAKE
  RESERVATION
  RELEASE
  CONSUMPTION
}

model StockMovement {
  id String @id @default(uuid()) @db.Uuid

  variantId   String @db.Uuid
  warehouseId String @db.Uuid

  type StockMovementType

  quantityChange        Int
  quantityOnHandAfter   Int
  quantityReservedAfter Int

  reason String? @db.VarChar(200)

  actorAccountId String? @db.Uuid
  orderId        String? @db.Uuid

  createdAt DateTime @default(now())

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  actor     Account?       @relation("StockMovementActor", fields: [actorAccountId], references: [id], onDelete: SetNull)
  order     Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt], map: "idx_stock_movement_variant_created")
  @@index([type], map: "idx_stock_movement_type")
  @@index([orderId], map: "idx_stock_movement_order")
}

model Cart {
  id String @id @default(uuid()) @db.Uuid

  customerProfileId String @db.Uuid

  status CartStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  items           CartItem[]

  @@index([customerProfileId], map: "idx_cart_customer")
  @@index([status], map: "idx_cart_status")
}

model CartItem {
  id String @id @default(uuid()) @db.Uuid

  cartId    String @db.Uuid
  variantId String @db.Uuid

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId], map: "uq_cart_item_cart_variant")
  @@index([variantId], map: "idx_cart_item_variant")
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

model Order {
  id String @id @default(uuid()) @db.Uuid

  orderNumber String @unique @db.VarChar(50)

  customerProfileId String @db.Uuid

  status OrderStatus @default(DRAFT)

  subtotalAmount Decimal @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  currency       String  @db.VarChar(10)

  addressId String? @db.Uuid

  // Immutable copy of the address at checkout time: later edits or deletion of
  // the Address row must not rewrite where an order was shipped.
  deliveryAddress Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  address         Address?         @relation(fields: [addressId], references: [id], onDelete: SetNull)
  delivery        Delivery?
  items           OrderItem[]
  payments        Payment[]
  stockMovements  StockMovement[]

  @@index([status], map: "idx_order_status")
  @@index([customerProfileId], map: "idx_order_customer")
  @@index([addressId], map: "idx_order_address")
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid

  orderId   String @db.Uuid
  variantId String @db.Uuid

  quantity Int

  unitPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "idx_order_item_order")
  @@index([variantId], map: "idx_order_item_variant")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  REFUNDED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BANK_TRANSFER
  MANUAL_TRANSFER_VERIFICATION
  ONLINE_GATEWAY
}

enum NotificationType {
  ORDER
  PAYMENT
  DELIVERY
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  accountId String @db.Uuid

  type NotificationType

  title String  @db.VarChar(200)
  body  String? @db.Text

  entityType String? @db.VarChar(50)
  entityId   String? @db.VarChar(100)

  readAt DateTime?

  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, readAt], map: "idx_notification_account_read")
  @@index([accountId, createdAt], map: "idx_notification_account_created")
  @@index([entityType, entityId], map: "idx_notification_entity")
}

model NotificationPreference {
  id String @id @default(uuid()) @db.Uuid

  accountId String @db.Uuid
  type      NotificationType

  inApp Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, type], map: "uq_notification_preference_account_type")
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid

  status PaymentStatus @default(PENDING)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @db.VarChar(10)

  method PaymentMethod?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "idx_payment_order")
  @@index([status], map: "idx_payment_status")
}
