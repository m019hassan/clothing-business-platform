{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/app/*": ["./app/*"],
      "@/modules": ["./modules"],
      "@/modules/*": ["./modules/*"],
      "@/shared": ["./shared"],
      "@/shared/*": ["./shared/*"],
      "@/components": ["./components"],
      "@/components/*": ["./components/*"],
      "@/hooks": ["./hooks"],
      "@/hooks/*": ["./hooks/*"],
      "@/providers": ["./providers"],
      "@/providers/*": ["./providers/*"],
      "@/config": ["./config"],
      "@/config/*": ["./config/*"],
      "@/constants": ["./constants"],
      "@/constants/*": ["./constants/*"],
      "@/lib": ["./lib"],
      "@/lib/*": ["./lib/*"],
      "@/types": ["./types"],
      "@/types/*": ["./types/*"],
      "@/styles": ["./styles"],
      "@/styles/*": ["./styles/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
