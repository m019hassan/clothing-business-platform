# Copy to .env and fill in real values.

# PostgreSQL connection string.
# Local Prisma dev server: postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&pgbouncer=true
# Docker compose service:   postgresql://app_user:<password>@postgres:5432/clothing_business_platform
DATABASE_URL=""

# Secret used to hash session tokens (required). Generate with: openssl rand -hex 32
AUTH_SECRET=""

# Hours of cart inactivity after which reservations expire (default 48).
RESERVATION_TTL_HOURS="48"

# Structured log threshold: debug | info | warn | error (default info).
LOG_LEVEL="info"

# Where uploaded payment receipts are stored (default: .data/uploads inside the project).
# Point it at a mounted volume or swap src/lib/storage for object storage in production.
UPLOAD_DIR=".data/uploads"

# Uploads: leave as "fs" on a laptop or a host with a mounted disk.
# On hosts with an ephemeral disk (Vercel, Render free) use an S3-compatible bucket:
# Cloudflare R2, Supabase Storage (S3 endpoint), MinIO or AWS S3.
STORAGE_DRIVER="fs"
# S3_BUCKET="clothing-uploads"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_PREFIX="uploads/"
